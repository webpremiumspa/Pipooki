<%- include('../partials/public-head') %>

<section class="hero">
  <div class="hero-badge">&#128062; <%= brand %></div>
  <h1 class="pet-name">Pagina no encontrada</h1>
  <p class="pet-claim">La direccion que abriste no existe.</p>
</section>

<% if (typeof detail !== 'undefined' && detail) { %>
  <section class="card card-tip">
    <h2>Detalle tecnico</h2>
    <p class="mono"><%= detail %></p>
    <p class="muted small">
      Este bloque solo aparece cuando la aplicacion no esta en modo produccion.
    </p>
  </section>
<% } %>

<%- include('../partials/public-foot') %>
