<%- include('../partials/public-head') %>

<section class="hero">
  <div class="hero-badge">&#128062; <%= brand %></div>
  <h1 class="pet-name">Placa desactivada</h1>
  <p class="pet-claim">
    <% if (typeof suspended !== 'undefined' && suspended) { %>
      Esta placa esta suspendida y no muestra datos de contacto.
    <% } else { %>
      Su dueno desactivo esta placa, asi que no muestra datos de contacto.
    <% } %>
  </p>
</section>

<section class="card card-tip">
  <h2>Encontraste una mascota con esta placa?</h2>
  <p>
    Llevala a una veterinaria para revisar si tiene microchip, o publicala en
    los grupos de mascotas perdidas de la comuna.
  </p>
</section>

<%- include('../partials/public-foot') %>
