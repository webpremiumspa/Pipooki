<%- include('../partials/admin-head') %>

<div class="page-head">
  <h1>Editar <%= pet.name %></h1>
  <div class="page-actions">
    <a class="btn btn-ghost" href="<%= url('/admin/mascotas') %>">Volver</a>
    <% if (pet.tag_id) { %>
      <a class="btn btn-ghost" href="<%= url('/admin/placas/' + pet.tag_id) %>">Ver placa <%= pet.code %></a>
    <% } %>
  </div>
</div>

<% if (errors.length) { %>
  <div class="alert">
    <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
  </div>
<% } %>

<form class="panel form" method="post"
      action="<%= url('/admin/mascotas/' + pet.id + '/editar') %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="grid-2">
    <div class="field">
      <label for="name">Nombre de la mascota *</label>
      <input id="name" name="name" value="<%= pet.name || '' %>" required maxlength="120">
    </div>
    <div class="field">
      <label for="species">Especie</label>
      <select id="species" name="species">
        <% SPECIES.forEach(function (s) { %>
          <option value="<%= s %>" <%= pet.species === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="breed">Raza</label>
      <input id="breed" name="breed" value="<%= pet.breed || '' %>" maxlength="120">
    </div>
    <div class="field">
      <label for="color">Color / senas</label>
      <input id="color" name="color" value="<%= pet.color || '' %>" maxlength="120">
    </div>
    <div class="field">
      <label for="sex">Sexo</label>
      <select id="sex" name="sex">
        <option value="" <%= !pet.sex ? 'selected' : '' %>>Sin especificar</option>
        <option value="macho" <%= pet.sex === 'macho' ? 'selected' : '' %>>Macho</option>
        <option value="hembra" <%= pet.sex === 'hembra' ? 'selected' : '' %>>Hembra</option>
      </select>
    </div>
    <div class="field">
      <label for="birth_year">Ano de nacimiento</label>
      <input id="birth_year" name="birth_year" type="number" min="1990" max="<%= new Date().getFullYear() %>"
             value="<%= pet.birth_year || '' %>">
    </div>
    <div class="field">
      <label for="chip_number">Numero de microchip</label>
      <input id="chip_number" name="chip_number" value="<%= pet.chip_number || '' %>" maxlength="60">
    </div>
    <div class="field">
      <label for="reward_note">Recompensa</label>
      <input id="reward_note" name="reward_note" value="<%= pet.reward_note || '' %>" maxlength="255">
    </div>
  </div>

  <div class="field">
    <label for="photo">Foto</label>
    <input id="photo" type="file" accept="image/jpeg,image/png,image/webp" data-resize="1000">
      <input type="hidden" id="photo_data" name="photo_data">
      <p class="muted small" id="photoStatus" role="status" aria-live="polite"></p>
    <small>JPG, PNG o WEBP, hasta 4 MB. Se reduce automaticamente antes de subirla.</small>
    <% if (pet.photo) { %>
      <div class="photo-current">
        <img src="<%= url('/uploads/' + pet.photo) %>" alt="Foto actual">
        <label class="check"><input type="checkbox" name="remove_photo" value="1"> Quitar la foto actual</label>
      </div>
    <% } %>
  </div>

  <div class="field">
    <label for="medical_notes">Datos medicos (se muestran en la pagina publica)</label>
    <textarea id="medical_notes" name="medical_notes" rows="3" maxlength="2000"><%= pet.medical_notes || '' %></textarea>
  </div>

  <div class="field">
    <label for="behavior_notes">Como acercarse (se muestra en la pagina publica)</label>
    <textarea id="behavior_notes" name="behavior_notes" rows="3" maxlength="2000"><%= pet.behavior_notes || '' %></textarea>
  </div>

  <label class="check">
    <input type="checkbox" name="sterilized" value="1" <%= pet.sterilized ? 'checked' : '' %>> Esterilizado
  </label>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Guardar cambios</button>
  </div>
</form>

<section class="panel danger-zone">
  <h2>Eliminar mascota</h2>
  <p class="muted">Se borra su historial de escaneos y su placa vuelve al inventario.</p>
  <form method="post" action="<%= url('/admin/mascotas/' + pet.id + '/eliminar') %>"
        data-confirm="Seguro que quieres eliminar a <%= pet.name %>?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-danger" type="submit">Eliminar mascota</button>
  </form>
</section>

<script src="<%= url('/js/photo.js') %>"></script>
<%- include('../partials/admin-foot') %>
