<%- include('../partials/admin-head') %>

<div class="page-head">
  <h1>Editar dueno</h1>
  <div class="page-actions">
    <a class="btn btn-ghost" href="<%= url('/admin/duenos/' + owner.id) %>">Volver</a>
  </div>
</div>

<% if (errors.length) { %>
  <div class="alert">
    <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
  </div>
<% } %>

<form class="panel form" method="post" action="<%= url('/admin/duenos/' + owner.id + '/editar') %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="grid-2">
    <div class="field">
      <label for="name">Nombre completo *</label>
      <input id="name" name="name" value="<%= owner.name || '' %>" required maxlength="150">
    </div>
    <div class="field">
      <label for="email">Correo *</label>
      <input id="email" name="email" type="email" value="<%= owner.email || '' %>" required maxlength="190">
      <small>
        Es su identidad: con este correo pide el codigo para entrar a editar.
        Cambiarlo aqui le devuelve el acceso si perdio el buzon anterior.
      </small>
    </div>
    <div class="field">
      <label for="phone">Telefono principal *</label>
      <input id="phone" name="phone" value="<%= owner.phone || '' %>" required maxlength="40" placeholder="+56 9 1234 5678">
      <small>Se usa para el boton de llamada y el de WhatsApp en la placa.</small>
    </div>
    <div class="field">
      <label for="phone_alt">Telefono alternativo</label>
      <input id="phone_alt" name="phone_alt" value="<%= owner.phone_alt || '' %>" maxlength="40">
    </div>
    <div class="field">
      <label for="address">Direccion</label>
      <input id="address" name="address" value="<%= owner.address || '' %>" maxlength="255" placeholder="Calle y numero">
      <small>No se muestra en la pagina publica hasta que la persona la solicita.</small>
    </div>
    <div class="field">
      <label for="comuna">Comuna</label>
      <input id="comuna" name="comuna" value="<%= owner.comuna || '' %>" maxlength="120">
    </div>
    <div class="field">
      <label for="city">Ciudad / Region</label>
      <input id="city" name="city" value="<%= owner.city || '' %>" maxlength="120">
    </div>
  </div>

  <div class="field">
    <label for="notes">Notas internas</label>
    <textarea id="notes" name="notes" rows="3" maxlength="2000"><%= owner.notes || '' %></textarea>
    <small>Solo visibles en este panel.</small>
  </div>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Guardar cambios</button>
  </div>
</form>

<%- include('../partials/admin-foot') %>
