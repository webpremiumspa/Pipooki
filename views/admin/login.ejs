<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · <%= brand %></title>
  <link rel="stylesheet" href="<%= url('/css/admin.css') %>">
</head>
<body class="login-body">
  <form class="login-card" method="post" action="<%= url('/admin/login') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h1><%= brand %> <span>Find</span></h1>
    <p class="muted">Panel de administracion</p>

    <% if (error) { %><div class="alert"><%= error %></div><% } %>

    <label for="email">Correo</label>
    <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="username" autofocus>

    <label for="password">Clave</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">

    <button class="btn btn-primary" type="submit">Ingresar</button>
  </form>
</body>
</html>
