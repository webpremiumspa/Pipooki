# ------------------------------------------------------------------
# Pipooki Find - variables de entorno
# Copiar como .env y completar. NUNCA subir el .env al repositorio.
# ------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# Ruta publica donde queda montada la app.
# Dev  : /find      (dev.webpremium.cl/find)
# Prod : /find      (pipookis.cl/find)
# Si la montaras en la raiz del dominio, dejar vacio.
BASE_PATH=/find

# Dominio publico SIN slash final. Se usa para armar la URL del QR.
# Dev  : https://dev.webpremium.cl
# Prod : https://pipookis.cl
PUBLIC_URL=https://pipookis.cl

# Clave de firma de sesiones. Generar una larga y aleatoria.
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# ---------------------------- MySQL -------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_cpanel
DB_PASSWORD=clave
DB_NAME=usuario_pipooki_find

# ---------------------- Correo (SMTP cPanel) ----------------------
# Cuenta de correo creada en cPanel, por ejemplo no-reply@pipookis.cl
SMTP_HOST=mail.pipookis.cl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@pipookis.cl
SMTP_PASSWORD=clave-del-buzon
SMTP_FROM="Pipooki <no-reply@pipookis.cl>"

# Minutos de espera antes de volver a avisar por el mismo QR.
# Evita llenar el buzon del dueno si escanean varias veces seguidas.
NOTIFY_COOLDOWN_MINUTES=10

# A donde llega el aviso de que activaron una placa.
ADMIN_NOTIFY_EMAIL=contacto@webpremium.cl

# Minutos de validez de un codigo OTP y cuantos intentos se permiten.
OTP_MINUTES=15
OTP_MAX_ATTEMPTS=5

# Horas que se guarda un registro sin confirmar antes de liberar la placa.
CLAIM_HOURS=24

# Duracion de la sesion del dueno tras validar su codigo.
OWNER_SESSION_MINUTES=30

# Intentos de PIN por placa antes de bloquear la activacion.
PIN_MAX_ATTEMPTS=10

# Placas por lote al fabricar.
BATCH_SIZE=10


# Marca
BRAND_NAME=Pipooki
